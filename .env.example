# =====================================================================
# domain-registrar-follow  --  ornek yapilandirma
# Kopyala:  cp .env.example .env  &&  chmod 600 .env
# =====================================================================

# ---------- Genel ----------
DOMAINS=ornek1.com.tr,ornek2.com.tr,ornek.com
DB_PATH=./data/domains.db
LOG_PATH=./logs/domain-monitor.log
LOG_LEVEL=INFO
TZ=Europe/Istanbul

# Poll araliklari (saniye)
POLL_NORMAL_SECONDS=900        # ACTIVE
POLL_EXPIRING_SECONDS=300      # EXPIRING / EXPIRED_GRACE
POLL_CRITICAL_SECONDS=60       # REDEMPTION / PENDING_DELETE / AVAILABLE
POLL_JITTER_SECONDS=15         # es zamanli sorgulari dagitmak icin
EXPIRING_DAYS=30

# Gunluk "hayattayim" bildirimi (0 = kapali), saat: 09:00 yerel
HEARTBEAT_ENABLED=true
HEARTBEAT_HOUR=9

# ---------- .com izleme (RDAP, kimlik gerektirmez) ----------
RDAP_BASE_URL=https://rdap.verisign.com/com/v1
RDAP_TIMEOUT=15
RDAP_USER_AGENT=domain-registrar-follow/2.0

# ---------- .com.tr izleme (TRABIS WHOIS port 43) ----------
WHOIS_TR_ENABLED=true
WHOIS_TR_HOST=whois.trabis.gov.tr
WHOIS_TR_PORT=43
WHOIS_TR_TIMEOUT=20
# nic.tr sorgu limiti sikidir. Iki sorgu arasi minimum bekleme (saniye).
WHOIS_TR_MIN_INTERVAL=60

# ---------- Uyarilar: Telegram ----------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Uyarilar: E-posta (SMTP) ----------
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true          # STARTTLS (587). 465 icin SMTP_USE_SSL=true kullan
SMTP_USE_SSL=false
SMTP_USERNAME=
# Gmail icin App Password (normal sifre degil)
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=yasargeren@gmail.com
# Sadece bu seviyeden itibaren mail at: INFO | WARNING | CRITICAL
EMAIL_MIN_SEVERITY=WARNING

# ---------- Uyarilar: Webhook (opsiyonel) ----------
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_TIMEOUT=10

# Ayni uyarinin tekrar gonderilmemesi icin susturma suresi (saniye)
ALERT_DEDUPE_SECONDS=21600

# ---------- Kayit guvenligi (SATIN ALMA) ----------
AUTO_REGISTER=false                 # PRODUCTION'A KADAR false
ACQUIRE_ALLOWLIST=ornek1.com.tr,ornek2.com.tr,ornek.com
REGISTER_DRY_RUN_FIRST=true         # once dryRun, sonra gercek istek
MAX_REGISTRATION_COST_USD=200       # bu fiyatin ustunde asla satin alma
REGISTRATION_MAX_ATTEMPTS=3
REGISTRATION_COOLDOWN_SECONDS=20
REGISTRATION_ATTEMPT_WINDOW_HOURS=24
REGISTRATION_MAX_ATTEMPTS_PER_WINDOW=25
# Bu dosya varsa hicbir kayit denemesi yapilmaz (acil durdurma):
KILL_SWITCH_FILE=./data/STOP

# ---------- .COM registrar: Porkbun ----------
PORKBUN_ENABLED=false
PORKBUN_BASE_URL=https://api.porkbun.com/api/json/v3
PORKBUN_API_KEY=
PORKBUN_SECRET_API_KEY=
PORKBUN_TIMEOUT=20
PORKBUN_WHOIS_PRIVACY=true
# checkDomain varsayilan limiti: 10 saniyede 1 sorgu
PORKBUN_CHECK_MIN_INTERVAL=10

# ---------- .COM.TR registrar (TRABIS akredite kayit kurulusu) ----------
# Kayit kurulusu secilip resmi API sozlesmesi alinana kadar false kalir.
TRABIS_ENABLED=false
TRABIS_REGISTRAR_NAME=
TRABIS_API_BASE_URL=
TRABIS_API_KEY=
TRABIS_API_SECRET=
TRABIS_TIMEOUT=20

# ---------- Kayit icin iletisim/NS bilgileri ----------
REGISTRANT_CONTACT_ID=
ADMIN_CONTACT_ID=
TECH_CONTACT_ID=
BILLING_CONTACT_ID=
NAMESERVERS=
